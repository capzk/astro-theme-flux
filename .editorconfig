# 与 .gitattributes（eol=lf）保持一致：Windows 编辑器也不往工作区写 CRLF
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown 里行尾两空格是硬换行语法，不能裁
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

---
/**
 * 文章页 —— /posts/<slug>/
 *
 * `slug` 来自 front matter 的 `slug` 字段，没写就由文件路径生成
 * （规则见 utils/slug.ts，一律小写 ASCII）。子目录会体现在路径里。
 *
 * 对应原版 post.ejs：banner + 白卡片（正文居中，右侧跟随滚动的目录）。
 * 保留阅读本身需要的部分：元信息、目录、标签、版权、上一篇/下一篇、相关文章，
 * 以及可选的评论与浏览量（评论系统可插拔，见 src/config 的 comment 段）。
 */
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../../components/Banner.astro';
import Board from '../../components/Board.astro';
import Icon from '../../components/Icon.astro';
import Toc from '../../components/Toc.astro';
import Comments from '../../components/Comments.astro';
import PageView from '../../components/PageView.astro';
import { SITE } from '../../config';
import { commentContext, commentOrigins, hasCommentForm, resolvePageview } from '../../comments';
import { T } from '../../i18n';
import {
  getPosts,
  neighbours,
  postUrl,
  postsBySlug,
  readingStats,
  relatedPosts,
  termUrl,
} from '../../utils/posts';
import { absoluteUrl, articleJsonLd, shareImage } from '../../utils/seo';
import { isAsset, srcOf } from '../../utils/image';

export async function getStaticPaths() {
  const posts = await getPosts();
  /* postsBySlug 会把 slug → 文章编好，并在两篇撞到同一个 URL 时直接构建失败 */
  return [...postsBySlug(posts)].map(([slug, post]) => ({
    params: { slug },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);

const { title, date, updated, tags, categories } = post.data;
const stats = readingStats(post, SITE.post.wpm);

const { prev, next } = neighbours(posts, post);

/* 相关文章（标签权重高于分类，零分的不要）。关掉开关就整块不渲染 */
const related = SITE.post.related ? relatedPosts(posts, post) : [];

/* 右侧目录：取 h2~h4。原版 tocbot 也默认收 h2 起，h5/h6 缩到第五层已经读不清。
   Astro 的 headings 本来就是文档顺序，直接过滤即可。 */
const tocItems = headings
  .filter((h) => h.depth >= 2 && h.depth <= 4)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));
const showToc = (post.data.toc ?? SITE.post.toc) && tocItems.length > 0;

/* 评论：站点开关、这篇没关、而且评论系统真的配好了 —— 三条都满足才渲染。
   少了最后一条就整块不渲染，不在页面上留一个注定失败的输入框。
   具体是哪一家由 config 的 comment.type 决定，这里不写死。 */
const showComments = hasCommentForm(SITE.comment, post.data.comment);

/* 浏览量：和评论区互不依赖，评论关掉也能单独统计。评论系统不支持就是 null */
const pageview = resolvePageview(
  SITE.comment,
  commentContext(Astro.url, { site: Astro.site, lang: SITE.lang }),
);

/* banner：单篇封面优先（`banner` 可优化 > `bannerImg` 字符串），其次站点默认图 */
const bannerSource = post.data.banner ?? post.data.bannerImg ?? SITE.postBanner.img;

const dateText = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedText = updated
  ? updated.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

/* banner 上的元信息，一个子数组 = 一行。与原版一致：
   第一行日期（作者开关打开时排在日期前面），第二行字数 + 阅读时长。 */
const metaTop: { icon: string; text: string }[] = [];
const metaBottom: { icon: string; text: string }[] = [];

if (SITE.post.meta.author) {
  metaTop.push({ icon: 'user', text: SITE.author });
}
if (SITE.post.meta.date) {
  metaTop.push({ icon: 'date', text: dateText });
}
if (SITE.post.meta.wordcount) {
  metaBottom.push({ icon: 'chart', text: `${stats.words} ${T.words}` });
}
if (SITE.post.meta.min2read) {
  metaBottom.push({ icon: 'clock', text: `${stats.minutes} ${T.minRead}` });
}
const metaRows = [metaTop, metaBottom];

const permalink = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

/* 分享封面。两个要求社交平台很挑剔：
   1) 格式 —— webp/avif 至今仍有个别平台抓不动，所以位图封面统一再转一版 JPEG；
   2) 比例 —— og:image 的标准是 1.91:1，用原图（3:2、16:9）会被平台居中裁掉一条，
      干脆按 1200×630 裁好再给出去。
   字符串路径（外部图 / public 里的图）没法参与转换，仍走 shareImage 的回落逻辑。 */
const ogImage = isAsset(bannerSource)
  ? absoluteUrl(
      (
        await getImage({
          src: bannerSource,
          width: 1200,
          height: 630,
          fit: 'cover',
          format: 'jpeg',
          quality: 82,
        })
      ).src,
      permalink,
    )
  : absoluteUrl(shareImage([srcOf(bannerSource)]), permalink);

const jsonLd = articleJsonLd({
  title,
  description: post.data.description ?? '',
  url: permalink,
  image: ogImage,
  published: date,
  modified: updated,
  section: categories[0],
  tags,
  words: stats.words,
});
---

<BaseLayout
  title={title}
  description={post.data.description}
  ogType="article"
  article={{ published: date, modified: updated, section: categories[0], tags }}
  jsonLd={jsonLd}
  image={ogImage}
  preconnect={commentOrigins(SITE.comment)}
>
  <Banner
    title={title}
    headingTag="div"
    img={bannerSource}
    height={SITE.postBanner.height}
    maskAlpha={post.data.bannerMaskAlpha ?? SITE.postBanner.maskAlpha}
    metas={metaRows}
  />

  <Board rails={showToc}>
    <article class="post-content">
      {/* 标题、日期、字数、时长都已在 banner 上；这里的 h1 与原版 #seo-header
          一样只服务 SEO 与打印，正常浏览时 display:none，避免标题出现两次 */}
      <h1 id="seo-header">{title}</h1>

      {
        updatedText && (
          <p class="post-meta post-meta-updated">
            <Icon name="clock" />
            {T.updatedPrefix} {updatedText}
          </p>
        )
      }

      {/* 阅读量紧挨着「最后更新于」：都是文章属性，放一起读起来是一组 */}
      {pageview && <PageView stat={pageview} />}

      <div class="markdown-body">
        <Content />
      </div>

      <footer class="post-footer">
        {
          (tags.length > 0 || categories.length > 0) && (
            <div class="post-tags">
              {categories.length > 0 && (
                <>
                  <span class="post-tags-label">
                    <Icon name="folder" />
                    {T.categories}
                  </span>
                  {categories.map((c) => (
                    <a class="tag-chip" href={termUrl('categories', c)}>
                      {c}
                    </a>
                  ))}
                </>
              )}
              {tags.length > 0 && (
                <>
                  <span class="post-tags-label">
                    <Icon name="tag" />
                    {T.tags}
                  </span>
                  {tags.map((t) => (
                    <a class="tag-chip" href={termUrl('tags', t)}>
                      #{t}
                    </a>
                  ))}
                </>
              )}
            </div>
          )
        }

        {
          SITE.post.copyright && (
            <div class="license-box">
              <div class="license-title">
                <div>{title}</div>
                <div>
                  <a href={permalink}>{permalink}</a>
                </div>
              </div>
              <div class="license-meta">
                <div class="license-meta-item">
                  <div>{T.copyrightAuthor}</div>
                  <div>{SITE.author}</div>
                </div>
                <div class="license-meta-item license-meta-date">
                  <div>{T.copyrightDate}</div>
                  <div>{dateText}</div>
                </div>
                <div class="license-meta-item">
                  <div>{T.copyrightLicense}</div>
                  <div>{T.copyrightLicenseValue}</div>
                </div>
              </div>
              <div class="license-icon" aria-hidden="true"></div>
            </div>
          )
        }

        {
          SITE.post.prevNext && (
            <nav class="post-prevnext" aria-label="上一篇 / 下一篇">
              {prev ? (
                <a href={postUrl(prev)}>
                  <Icon name="arrow-left" />
                  <span class="label">
                    {T.prevPost}：{prev.data.title}
                  </span>
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a href={postUrl(next)} class="post-next">
                  <span class="label">
                    {T.nextPost}：{next.data.title}
                  </span>
                  <Icon name="arrow-right" />
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </footer>

      {/* 相关文章放在版权与上下篇之后：读者读完、也知道这是谁的稿子了，再引向别处 */}
      {
        related.length > 0 && (
          <section class="related-posts" aria-labelledby="related-title">
            <h2 class="related-title" id="related-title">
              {T.related}
            </h2>
            <ul class="related-list">
              {related.map((item) => (
                <li class="related-item">
                  <a href={postUrl(item)}>
                    <span class="related-item-title">{item.data.title}</span>
                    <span class="related-item-meta">
                      <Icon name="date" />
                      {item.data.date.toLocaleDateString('zh-CN', {
                        year: 'numeric',
                        month: '2-digit',
                        day: '2-digit',
                      })}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
    {/* 评论放在 </article> 之外：它不是这篇稿子的一部分，是读者之间的对话。
        也正因为如此，它不能进 <article> 的语义里，屏幕阅读器才不会把它当正文念 */}
    {showComments && <Comments />}
    {showToc && <Toc slot="aside" items={tocItems} />}
  </Board>
</BaseLayout>

---
/**
 * 归档 —— /archives/
 *
 * 原版是一条居中时间线：年份标题 + 年份下按时间倒序的文章行。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../../components/Banner.astro';
import Board from '../../components/Board.astro';
import { SITE } from '../../config';
import { T } from '../../i18n';
import { getPosts, groupByYear, postUrl } from '../../utils/posts';

const posts = await getPosts();
const years = groupByYear(posts);
---

<BaseLayout title={T.archive}>
  <Banner title={T.archive} subtitle={T.totalPosts(posts.length)} img={SITE.postBanner.img} height="40vh" maskAlpha={SITE.postBanner.maskAlpha} />

  <Board>
    {
      years.map(([year, items]) => (
        <>
          <h2 class="archive-year">{year}</h2>
          <ul class="archive-list">
            {items.map((post) => (
              <li class="archive-item">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
                </time>
                <a href={postUrl(post)}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </>
      ))
    }
    {years.length === 0 && <p class="search-empty">还没有文章。</p>}
  </Board>
</BaseLayout>

---
/**
 * 标签云 —— /tags/
 *
 * 原版 Fluid 的标签页是「云」：字号随文章数变化。这里用 chip + 计数，
 * 点击进详情页。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../../components/Banner.astro';
import Board from '../../components/Board.astro';
import { SITE } from '../../config';
import { T } from '../../i18n';
import { getPosts, tagCounts, termUrl } from '../../utils/posts';

const posts = await getPosts();
const tags = tagCounts(posts);
---

<BaseLayout title={T.tags}>
  <Banner title={T.tags} subtitle={T.totalTags(tags.length)} img={SITE.postBanner.img} height="40vh" maskAlpha={SITE.postBanner.maskAlpha} />

  <Board>
    <div class="term-cloud">
      {
        tags.map(({ name, count }) => (
          <a class="term-chip" href={termUrl('tags', name)}>
            {name}
            <span class="term-count">{count}</span>
          </a>
        ))
      }
    </div>
    {tags.length === 0 && <p class="search-empty">还没有标签。</p>}
  </Board>
</BaseLayout>

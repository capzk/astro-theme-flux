---
/**
 * 首页 —— 门户 / CMS 风（实验）
 *
 * 选择性参考 hexo-theme-solitude / 知更鸟 Begin 的「杂志布局」，只改首页，
 * 其他页面完全不动。整体分三大块（顺序与密度都在 src/config/user/content.ts
 * 的 SITE.index.portal 里配）：
 *   ① 顶部置顶：左侧纯图片自动轮播 + 右侧「置顶文章」列表（同一批 featured）
 *   ② 中间分类列表：显式有序，每分类独立配「卡片」或「列表」
 *      （卡片每行几个 = cardsPerRow；列表几列 = cols），分类名与顺序自由排
 *   ③ 底部最新：不分类别，纯文字列表（cols 控制几列）
 * banner 显不显示看 SITE.banner.enable（关掉时顶栏自动转实色、内容下移留白）。
 * 样式在 src/styles/portal.css，复用 Flux 设计令牌。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Board from '../components/Board.astro';
import CategorySection from '../components/portal/CategorySection.astro';
import { Image } from 'astro:assets';
import { SITE } from '../config';
import {
  getPosts,
  stickyFirst,
  categoryCounts,
  postsWithTerm,
  postUrl,
  termUrl,
} from '../utils/posts';
import { isAsset, type ImageSource } from '../utils/image';
import { lqipStyle } from '../utils/lqip';
import { siteJsonLd } from '../utils/seo';
/* 门户首页（实验）样式：只在首页引入，避免内联进全站每一页 */
import '../styles/portal.css';

const all = await getPosts();
const ordered = stickyFirst(all);

/* 门户首页（实验）的显示数量都抽到 SITE.index.portal，调密度改配置即可 */
const portal = SITE.index.portal;

/* 置顶：前 N 篇同时驱动「左侧图片轮播」与「右侧置顶文章列表」 */
const featured = ordered.slice(0, portal.featured);

/* 中间分类列表：显式有序（portal.categories）；为空则退回按文章数前 8 个、卡片一行 */
const catNames = new Set(categoryCounts(all).map((c) => c.name));

/* 配置里写了、但文章 front matter 里根本不存在的分类名：会被下面 .filter 静默丢掉，
   整块凭空消失。这是最隐蔽的一类配置错误（多半是错别字或大小写不一致），
   构建期说一句，别让人对着「少了块内容」猜半天。 */
if (portal.categories.length) {
  const missing = portal.categories.map((s) => s.name).filter((name) => !catNames.has(name));
  if (missing.length) {
    console.warn(
      `[Flux] 首页 portal.categories 里这些分类名在文章里不存在，会被跳过：` +
        missing.map((n) => `「${n}」`).join(' ') +
        '。检查拼写与大小写，须与 front matter 的 categories 完全一致。',
    );
  }
}
const sections = (
  portal.categories.length
    ? portal.categories
    : categoryCounts(all).slice(0, 8).map((c) => ({
        name: c.name,
        layout: 'card' as const,
        rows: 1,
        cols: undefined,
        count: undefined,
      }))
)
  .filter((s) => catNames.has(s.name))
  .map((s) => {
    const posts = postsWithTerm(all, 'categories', s.name);
    let count: number;
    if (typeof s.count === 'number') count = s.count;
    else if (s.layout === 'card') count = (s.rows ?? 1) * portal.cardsPerRow;
    else count = (s.cols ?? 1) * 5; // 列表每列 5 篇
    return {
      name: s.name,
      count: posts.length,
      posts: posts.slice(0, count),
      layout: s.layout,
      cols: s.layout === 'list' ? (s.cols ?? 1) : undefined,
      moreUrl: termUrl('categories', s.name),
    };
  });

const jsonLd = siteJsonLd(Astro.site ?? Astro.url.origin);
---

<BaseLayout isHome jsonLd={jsonLd}>
  {/* banner 关掉、或标题留空时，页面会失去唯一的 h1。补一个只给读屏和搜索引擎看的标题 */}
  {(!SITE.banner.enable || !(SITE.banner.title ?? SITE.title)) && <h1 class="sr-only">{SITE.title}</h1>}

  {
    SITE.banner.enable && (
      <Banner
        title={SITE.banner.title ?? SITE.title}
        subtitle={SITE.banner.slogan || SITE.subtitle}
        img={SITE.banner.img}
        height={SITE.banner.height}
        maskAlpha={SITE.banner.maskAlpha}
        scrollDown={SITE.banner.scrollDown}
        typing={SITE.banner.typing}
      />
    )
  }

  <Board wide>
    {
      all.length === 0 ? (
        <p class="search-empty">还没有文章。在 src/content/posts/ 里放一篇 Markdown 就会出现。</p>
      ) : (
        <div class="portal" style={`--portal-cards-per-row:${portal.cardsPerRow}`}>
          <div class="portal-main">
            {/* 置顶：左侧图片轮播 + 右侧置顶文章列表 */}
            {
              featured.length > 0 && (
                <section class="pfeature">
                  <div class="phero-carousel" data-autoplay={portal.heroAutoplay}>
                    {featured.map((p, i) => {
                      const cover: ImageSource = p.data.cover ?? p.data.indexImg ?? SITE.index.defaultImg;
                      return (
                        <a
                          class:list={['phero-slide', { 'is-active': i === 0 }]}
                          href={postUrl(p)}
                          style={isAsset(cover) ? lqipStyle(cover) : undefined}
                          aria-label={p.data.title}
                          inert={i !== 0}
                        >
                          {isAsset(cover) ? (
                            <Image
                              class="phero-img"
                              src={cover}
                              alt={p.data.title}
                              widths={[320, 480, 720, 960]}
                              sizes="(max-width: 720px) 100vw, 600px"
                              loading={i === 0 ? 'eager' : 'lazy'}
                            />
                          ) : (
                            <img class="phero-img" src={cover} alt={p.data.title} loading={i === 0 ? 'eager' : 'lazy'} />
                          )}
                        </a>
                      );
                    })}
                    {featured.length > 1 && (
                      <div class="phero-dots">
                        {featured.map((_, i) => (
                          <button
                            type="button"
                            class:list={['phero-dot', { 'is-active': i === 0 }]}
                            data-i={i}
                            aria-label={`第 ${i + 1} 张`}
                            aria-current={i === 0 ? 'true' : undefined}
                          />
                        ))}
                      </div>
                    )}
                  </div>

                  <div class="pfeature-side">
                    <ul class="pfeature-list">
                      {featured.map((p) => (
                        <li>
                          <a href={postUrl(p)}>{p.data.title}</a>
                          {SITE.index.showDate && (
                            <span class="post-meta">
                              <time datetime={p.data.date.toISOString()}>
                                {p.data.date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
                              </time>
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                </section>
              )
            }

            {/* 各分类分区 */}
            {sections.map((s) => <CategorySection {...s} />)}

            {/* 最新发布：不分类别，左右两列纯文字列表 */}
            <CategorySection
              name="最新"
              count={all.length}
              posts={ordered.slice(0, portal.latest.count)}
              layout="list"
              cols={portal.latest.cols}
              moreUrl="/archives/"
            />
          </div>
        </div>
      )
    }
  </Board>

  <script>
    /* 置顶图片轮播：纯图片自动切换 + 圆点切换 + 手机上左右滑动切换；
       鼠标悬停或键盘聚焦时暂停。没有 JS 时只显示第一张（.is-active），页面依旧可读。
       开了系统「减少动态效果」就不自动播放，读者仍可手动点圆点 / 滑动切换。 */
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const carousels = document.querySelectorAll<HTMLElement>('.phero-carousel');
    for (const el of carousels) {
      const slides = Array.from(el.querySelectorAll<HTMLElement>('.phero-slide'));
      const dots = Array.from(el.querySelectorAll<HTMLElement>('.phero-dot'));
      if (slides.length <= 1) continue;
      let idx = 0;
      const ms = reducedMotion ? 0 : Number(el.dataset.autoplay) || 0;
      let timer = 0;
      let hovering = false;
      let focused = false;
      const go = (n: number) => {
        idx = (n + slides.length) % slides.length;
        slides.forEach((s, i) => {
          const active = i === idx;
          s.classList.toggle('is-active', active);
          /* 非当前张设 inert：不可 Tab、不可点，读屏也不会念到被 opacity:0 藏起来的链接 */
          s.inert = !active;
        });
        dots.forEach((d, i) => {
          const active = i === idx;
          d.classList.toggle('is-active', active);
          if (active) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
        });
      };
      const stop = () => {
        if (timer) window.clearInterval(timer);
        timer = 0;
      };
      const start = () => {
        stop();
        if (ms > 0) timer = window.setInterval(() => go(idx + 1), ms);
      };
      /* 悬停或键盘焦点任一还在轮播里，就不恢复自动播放 */
      const resume = () => {
        if (!hovering && !focused) start();
      };
      dots.forEach((d, i) => d.addEventListener('click', () => {
        go(i);
        stop();
      }));
      el.addEventListener('mouseenter', () => {
        hovering = true;
        stop();
      });
      el.addEventListener('mouseleave', () => {
        hovering = false;
        resume();
      });
      /* 键盘进入轮播时也暂停；焦点在圆点之间移动不算离开 */
      el.addEventListener('focusin', () => {
        focused = true;
        stop();
      });
      el.addEventListener('focusout', (event) => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !el.contains(next)) {
          focused = false;
          resume();
        }
      });
      /* ---- 触屏：手指左右滑也能切 ----
         手机上既没有 hover 也没有 mouseleave，「悬停暂停 + 圆点」那一套基本失效，
         而且 9px 的圆点在触屏上很难点中。所以补两条：
           1. 横滑超过 40px 且明显大于纵向位移 → 切上一张 / 下一张；
           2. 滑完之后浏览器补的那次 click 必须拦掉，否则顺手就把当前这张的链接打开了。
         手指一碰就先停掉自动播放，免得滑动途中自己翻页；只是点了一下没滑的话再恢复。 */
      let downX = 0;
      let downY = 0;
      let swiped = false;
      el.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse') return;
        swiped = false;
        downX = event.clientX;
        downY = event.clientY;
        stop();
      });
      el.addEventListener('pointerup', (event) => {
        if (event.pointerType === 'mouse') return;
        const dx = event.clientX - downX;
        const dy = event.clientY - downY;
        if (Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy)) {
          swiped = true;
          go(dx < 0 ? idx + 1 : idx - 1);
          return;
        }
        start();
      });
      /* 手指一滑就变成页面滚动，pointerup 不会来，别把自动播放停死在这儿 */
      el.addEventListener('pointercancel', () => start());
      /* 捕获阶段先拦一次：滑动之后的那次 click 不该变成跳转 */
      el.addEventListener('click', (event) => {
        if (!swiped) return;
        swiped = false;
        event.preventDefault();
        event.stopPropagation();
      }, true);
      go(0);
      start();
    }
  </script>
</BaseLayout>

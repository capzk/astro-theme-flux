---
/**
 * 首页 —— banner + 卡片流
 *
 * 原版 index.ejs 就是这个结构：全屏 banner（站名 + 副标题 + 滚动箭头），
 * 下面一张白卡片里排着文章卡片。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Board from '../components/Board.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { getPosts, stickyFirst } from '../utils/posts';
import { siteJsonLd } from '../utils/seo';

const all = await getPosts();
const ordered = stickyFirst(all);

const pageSize = SITE.pageSize;
const posts = ordered.slice(0, pageSize);
const lastPage = Math.max(1, Math.ceil(ordered.length / pageSize));

/* WebSite + Organization + Person 三个实体一次声明，文章页用 @id 指回来 */
const jsonLd = siteJsonLd(Astro.site ?? Astro.url.origin);
---

<BaseLayout isHome jsonLd={jsonLd}>
  {
    /* banner 显不显示、长什么样，全看 src/config/user/appearance.ts —— 不用改这里 */
    SITE.banner.enable && (
      <Banner
        title={SITE.banner.title ?? SITE.title}
        subtitle={SITE.banner.slogan || SITE.subtitle}
        img={SITE.banner.img}
        height={SITE.banner.height}
        maskAlpha={SITE.banner.maskAlpha}
        scrollDown={SITE.banner.scrollDown}
        typing={SITE.banner.typing}
      />
    )
  }

  <Board>
    <PostList posts={posts} currentPage={1} lastPage={lastPage} />
  </Board>
</BaseLayout>

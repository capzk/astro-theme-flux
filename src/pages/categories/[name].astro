---
/**
 * 单个分类 —— /categories/<名称>/（第 1 页）
 *
 * 第 2 页起走 `/categories/<名称>/page/N/`。中文分类名直接进 URL，与 Hexo 版一致。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../../components/Banner.astro';
import Board from '../../components/Board.astro';
import PostList from '../../components/PostList.astro';
import { SITE } from '../../config';
import {
  categoryCounts,
  getPosts,
  paginate,
  postsWithTerm,
  termUrl,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return categoryCounts(posts).map(({ name, count }) => {
    const list = postsWithTerm(posts, 'categories', name);
    const { lastPage, page } = paginate(list, SITE.pageSize);
    return {
      params: { name },
      props: { name, count, posts: page(1), lastPage, base: termUrl('categories', name) },
    };
  });
}

const { name, count, posts, lastPage, base } = Astro.props;
---

<BaseLayout title={name} description={`分类「${name}」下的 ${count} 篇文章`}>
  <Banner
    title={name}
    subtitle={`${count} 篇文章`}
    img={SITE.postBanner.img}
    height="40vh"
    maskAlpha={SITE.postBanner.maskAlpha}
  />

  <Board>
    <PostList posts={posts} currentPage={1} lastPage={lastPage} base={base} />
  </Board>
</BaseLayout>

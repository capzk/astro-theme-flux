---
/**
 * BaseLayout —— 全站骨架
 *
 * 结构对应原版 layout.ejs：head + 顶栏 + main + 页脚 + 脚本。
 * 深色模式与首帧防闪在这里处理（内联脚本，阻塞渲染但只有几行）。
 */
import { SITE } from '../config';
import { T } from '../i18n';
import { absoluteUrl, ogLocale, shareImage } from '../utils/seo';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import Icon from '../components/Icon.astro';
import '../styles/main.css';

/** 文章页专属的分享元信息，对应 og:type=article 那几个字段 */
interface ArticleMeta {
  published: Date;
  modified?: Date;
  section?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  /** 页面自身 URL，用于 canonical / og:url */
  ogType?: 'website' | 'article';
  /** 首页：顶栏透明 */
  isHome?: boolean;
  /** 分享封面（站内路径或绝对地址）；传 SVG 会自动回落到 SITE.ogImage */
  image?: string;
  /** og:type=article 时用；不传就不输出 article:* 那几行 */
  article?: ArticleMeta;
  /** 结构化数据（JSON-LD 对象或其数组），由页面用 utils/seo 生成 */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * 提前握手的域名（`<link rel="preconnect">`）。只给「要等到很后面才用得上、
   * 但用上时希望连接已经热着」的第三方 —— 目前是评论服务端与它的客户端脚本。
   * 站内地址不用传，浏览器本来就有连接。
   */
  preconnect?: string[];
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  isHome = false,
  image,
  article,
  jsonLd,
  preconnect = [],
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE.title}` : `${SITE.title} - ${SITE.subtitle}`;
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).href;
const path = Astro.url.pathname;

/* 分享封面必须是绝对地址，且不能是 SVG（平台会渲染成空白卡片） */
const shareImg = absoluteUrl(shareImage([image]), origin);
const shareAlt = title ? `${title} - ${SITE.title}` : `${SITE.title} · ${SITE.subtitle}`;

/* 同源的不必再握手（评论服务端和博客挂同一个域时会出现这种情况） */
const preconnectList = preconnect.filter((item) => item !== origin.origin);

/**
 * 首页 banner 用字符串路径（`/img/x.webp`）时，图是 CSS background 加载的：
 * 浏览器要等 CSSOM 解析完才发现它，比 `<Image>` 生成的 `<img>` 晚一拍。
 * 补一条 preload 把 LCP 抢回来。import 的资源自带 fetchpriority，不用管。
 */
const bannerImg = isHome && SITE.banner.enable ? SITE.banner.img : undefined;
const bannerPreload = typeof bannerImg === 'string' ? bannerImg.trim() : '';

/* 浏览器地址栏配色。亮色跟随配置里的顶栏色，暗色取 main.css 里那套固定值 ——
   用户手动切换过主题时可能与实际不符，但地址栏只是装饰，不值得为此加脚本。 */
const DARK_CHROME = '#1f3144';

/**
 * src/config 的 color 段 → 覆盖 main.css 里亮色那组变量。
 * 只作用于亮色：暗色那套留在 main.css 的 [data-user-color-scheme="dark"] 里，
 * 这里若无条件写 :root 会把暗色一起盖掉。想连暗色改，去改 main.css 的变量。
 * 选择器用 html:root:not(...) 是为了稳定赢过 main.css 的 :root（特异性 0,2,1 > 0,1,0），
 * 免得和样式表的注入顺序赛跑。
 */
const colorVars =
  `html:root:not([data-user-color-scheme='dark']){` +
  `--navbar-bg-color:${SITE.color.navbar};` +
  `--body-bg-color:${SITE.color.bodyBg};` +
  `--board-bg-color:${SITE.color.board};` +
  `--link-hover-color:${SITE.color.accent};}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    {/* 首屏大图的 preload，见 frontmatter 里 bannerPreload 的说明 */}
    {
      bannerPreload && (
        <link rel="preload" as="image" href={bannerPreload} fetchpriority="high" />
      )
    }
    {/* 放在 </head> 最前面几条里：握手要趁早，评论脚本是懒加载的，
        等它开始下载再握手就白等一个 RTT 了 */}
    {
      preconnectList.map((item) => (
        <>
          <link rel="preconnect" href={item} />
          {/* 老浏览器没有 preconnect 时退化成 DNS 预解析，聊胜于无 */}
          <link rel="dns-prefetch" href={item} />
        </>
      ))
    }
    <meta name="theme-color" content={SITE.color.navbar} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={DARK_CHROME} media="(prefers-color-scheme: dark)" />

    <!-- 配色来自 src/config 的 color 段，只覆盖亮色（见 frontmatter 里的说明） -->
    <style is:inline set:html={colorVars} />

    <!--
      Open Graph / Twitter。两家的字段大部分重叠，但都不接受相对路径：
      地址与封面在 frontmatter 里已经绝对化（见 utils/seo.ts）。
      封面尺寸因文章而异，标错不如不标，所以不写 og:image:width/height。
    -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={ogLocale()} />
    <meta property="og:image" content={shareImg} />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImg} />
    <meta name="twitter:image:alt" content={shareAlt} />

    {
      ogType === 'article' && article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && (
            <meta property="article:modified_time" content={article.modified.toISOString()} />
          )}
          <meta property="article:author" content={SITE.author} />
          {article.section && <meta property="article:section" content={article.section} />}
          {(article.tags ?? []).map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <!-- 结构化数据：由页面用 utils/seo 生成，这里只负责输出 -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!--
      深色模式：首帧就把 data-user-color-scheme 写到 html 上，避免闪白。
      优先级：用户手动选择（localStorage）> 站点默认值 > 系统偏好。
      必须是内联脚本（外链脚本会晚一帧），代价只有几行。
    -->
    <script is:inline define:vars={{ darkDefault: SITE.darkMode.enable ? SITE.darkMode.default : 'light' }}>
      (function () {
        try {
          var saved = localStorage.getItem('flux-color-scheme');
          var mode = saved;
          if (!mode || mode === 'auto') {
            if (darkDefault === 'auto') {
              mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            } else {
              mode = darkDefault;
            }
          }
          document.documentElement.dataset.userColorScheme = mode;
        } catch (e) {
          document.documentElement.dataset.userColorScheme = 'light';
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{T.skipToContent}</a>

    <Navbar isHome={isHome} path={path} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {SITE.search && <SearchModal />}

    <button id="scroll-top" type="button" aria-label={T.backTop}>
      <Icon name="arrow-up" />
    </button>

    <script>
      import '../scripts/theme.js';
      import '../scripts/banner.js';
      /* 搜索只在站点开启时打包进页面（未开启时这段引用会被摇掉） */
      import '../scripts/search.js';
    </script>
  </body>
</html>

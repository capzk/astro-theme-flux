---
/**
 * BaseLayout —— 全站骨架
 *
 * 结构对应原版 layout.ejs：head + 顶栏 + main + 页脚 + 脚本。
 * 深色模式与首帧防闪在这里处理（内联脚本，阻塞渲染但只有几行）。
 */
import { SITE } from '../config';
import { T } from '../i18n';
import { absoluteUrl, imageMimeOf, ogLocale, shareImage, twitterHandle } from '../utils/seo';
import { safeJson } from '../utils/json';
import { isListPage } from '../utils/list-pages';
import type { ImageSource } from '../utils/image';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import Icon from '../components/Icon.astro';
import '../styles/main.css';
/* 门户首页（实验）样式：仅首页用到，单独的 css 便于整体回退 */
import '../styles/portal.css';

/** 文章页专属的分享元信息，对应 og:type=article 那几个字段 */
interface ArticleMeta {
  published: Date;
  modified?: Date;
  section?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  /** 页面自身 URL，用于 canonical / og:url */
  ogType?: 'website' | 'article';
  /** 首页：顶栏透明 */
  isHome?: boolean;
  /** 分享封面（站内路径或绝对地址）；传 SVG 会自动回落到 SITE.ogImage */
  image?: string;
  /**
   * 分享封面的像素尺寸 —— **只在确实知道的时候传**。
   *
   * 文章页自己裁 1200×630 时会传，于是 `og:image:width/height` 能如实输出：
   * 有些平台（Slack、LinkedIn、Discord）拿到宽高就直接排版，省掉一次探测请求。
   * 落到 `SITE.ogImage` 或直接引用原图的页面不传 —— 尺寸随图而变，
   * 标错比不标更糟：平台会照着错的宽高裁，出来的卡片比让它自己探测还难看。
   */
  imageSize?: { width: number; height: number };
  /** og:type=article 时用；不传就不输出 article:* 那几行 */
  article?: ArticleMeta;
  /** 结构化数据（JSON-LD 对象或其数组），由页面用 utils/seo 生成 */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * 提前握手的域名（`<link rel="preconnect">`）。只给「要等到很后面才用得上、
   * 但用上时希望连接已经热着」的第三方 —— 目前是评论服务端与它的客户端脚本。
   * 站内地址不用传，浏览器本来就有连接。
   */
  preconnect?: string[];
  /**
   * 这一页 banner 用的图（和传给 `<Banner img>` 的是同一个值）。
   *
   * 只在它是**字符串路径**时才用它补一条 `<link rel="preload" as="image">`：
   * 字符串图走 CSS `background-image`，浏览器要等 CSSOM 建好才发现它，
   * 比 `<img>` 晚一拍；`import` 进来的资源由 `<Image>` 渲染成 `<img>`，
   * 自带 `fetchpriority="high"`，不需要 preload。
   *
   * 不传则按「首页 / 分页首页用 `banner.img`、其余页面用 `postBanner.img`」推断 ——
   * 文章页会传自己的封面，否则会 preload 错一张图，白占首屏带宽。
   * **显式传 `null` 表示「这一页没有 banner」**（404 就是这种），不输出 preload。
   */
  bannerImg?: ImageSource | null;
  /**
   * 不索引这一页。默认由路径自动判定（见 utils/list-pages）——
   * 分页、单个标签页、单个分类页的内容都是一份文章清单，进索引只是重复内容。
   * 显式传 `false` 可以推翻自动判定。
   */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  isHome = false,
  image,
  article,
  jsonLd,
  preconnect = [],
  noindex,
  bannerImg,
  imageSize,
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE.title}` : `${SITE.title} - ${SITE.subtitle}`;
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).href;
const path = Astro.url.pathname;

/**
 * 列表页不索引。判定只写在 utils/list-pages 一处，astro.config 的 sitemap 过滤
 * 用的是同一个函数 —— 两边不可能对不上（「不在 sitemap」却「允许索引」是
 * 最容易被忽略的一类不一致：搜索引擎照样会抓，只是发现得慢）。
 *
 * 用 `noindex, follow` 而不是 `noindex, nofollow`：这些页面对读者是有用的导航，
 * 链接该跟还得跟，权重才能流向文章。
 */
const isNoindex = noindex ?? isListPage(path);

/**
 * 顶栏是否透明：只有「首页且 banner 开着」才透明（透明态导航文字直接压在
 * banner 图上）。banner 关掉时首页没有深色背景可压，透明导航的浅色字在白卡片
 * 上会糊掉，所以这时让它从一开始就实色 —— 和站内其它页面一致。
 * 这个值只决定顶栏观感，不影响 banner 的 preload 判定（那块仍用 isHome）。
 */
const navbarTransparent = isHome && SITE.banner.enable;

/**
 * 索引策略，两种取值互斥：
 *
 *   · 列表页   `noindex, follow` —— 不进索引，但链接照跟（理由见上）
 *   · 其余页面 `max-image-preview:large` —— 不写这一项，搜索结果里的缩略图
 *     只有默认的「标准」尺寸；写了才出大图。它只是**摘要**指令，不带 index/noindex，
 *     所以不会改变索引状态，没有副作用。
 *
 * 刻意不写 `nosnippet` / `max-snippet:0`：这两项会让页面失去被 AI 摘要引用的资格
 * （Google 的 AI Overviews 只引用「能出摘要」的页面），在有冲突指令时最严格的那条赢。
 */
const robotsContent = isNoindex ? 'noindex, follow' : 'max-image-preview:large';

/* 分享封面必须是绝对地址，且不能是 SVG（平台会渲染成空白卡片） */
const shareImg = absoluteUrl(shareImage([image]), origin);
const shareAlt = title ? `${title} - ${SITE.title}` : `${SITE.title} · ${SITE.subtitle}`;
const shareMime = imageMimeOf(shareImg);

/* 没配 X 账号就是 undefined，下面那两行 meta 整个不输出 */
const twitter = twitterHandle();

/* 同源的不必再握手（评论服务端和博客挂同一个域时会出现这种情况） */
const preconnectList = preconnect.filter((item) => item !== origin.origin);

/**
 * 首屏大图的 preload。
 *
 * 现状：banner 用字符串路径（`/img/x.webp`）时，图是 CSS 背景加载的 ——
 * 浏览器要等 CSSOM 建完才发现它，比 `<img>` 晚一拍。补一条 preload 把 LCP 抢回来。
 * `import` 进来的资源由 `<Image>` 输出 `<img fetchpriority="high">`，不用管。
 *
 * 页面不必各传一遍：默认按「首页 `banner.img`、其余 `postBanner.img`」推断，
 * 文章页的封面各不相同，由它自己传 `bannerImg` 覆盖 —— 否则会 preload 一张
 * 这一页根本不用的图，白占首屏带宽（preload 的优先级仅次于 CSS）。
 */
const bannerSource =
  bannerImg === null
    ? undefined
    : bannerImg ?? (isHome ? (SITE.banner.enable ? SITE.banner.img : undefined) : SITE.postBanner.img);
const bannerPreload = typeof bannerSource === 'string' ? bannerSource.trim() : '';

/* 浏览器地址栏配色。亮色跟随配置里的顶栏色，暗色取 main.css 里那套固定值 ——
   用户手动切换过主题时可能与实际不符，但地址栏只是装饰，不值得为此加脚本。 */
const DARK_CHROME = '#1f3144';

/**
 * src/config 的 color 段 → 覆盖 main.css 里亮色那组变量。
 * 只作用于亮色：暗色那套留在 main.css 的 [data-user-color-scheme="dark"] 里，
 * 这里若无条件写 :root 会把暗色一起盖掉。想连暗色改，去改 main.css 的变量。
 * 选择器用 html:root:not(...) 是为了稳定赢过 main.css 的 :root（特异性 0,2,1 > 0,1,0），
 * 免得和样式表的注入顺序赛跑。
 *
 * 第二条多了个 `:not([data-hue])`：只要 html 上有 data-hue（配置里写了 color.hue），
 * 字面的顶栏色 / 强调色就让位给 main.css 里 `html[data-hue]` 那组 oklch 规则。
 * 不这么写的话这条特异性更高（0,3,1），会把派生的颜色一直盖住。
 */
const colorVars =
  /* 页面底色与卡片色跟色相无关，任何情况下都用配置值 */
  `html:root:not([data-user-color-scheme='dark']){` +
  `--body-bg-color:${SITE.color.bodyBg};` +
  `--board-bg-color:${SITE.color.board};}` +
  `html:root:not([data-user-color-scheme='dark']):not([data-hue]){` +
  `--navbar-bg-color:${SITE.color.navbar};` +
  `--link-hover-color:${SITE.color.accent};}` +
  /* 顶栏透明态那层渐变压暗不分亮暗 —— 它压的是照片，不是主题色，
     所以单独写在 :root 上，暗色下同样生效 */
  `html:root{--navbar-scrim:${SITE.color.navbarScrim};}`;

/**
 * 色相派生：配了 `color.hue` 就在 <html> 上落 `data-hue` 与 `--hue`，
 * 具体颜色由 main.css 里 `html[data-hue]` 那组规则按亮暗各算一套。
 * 没配就什么也不加 —— 默认观感与以前逐像素一致。
 */
const hue = typeof SITE.color.hue === 'number' ? SITE.color.hue : null;

/* ---------------------------------------------------------------------------
 * 访客统计
 * ---------------------------------------------------------------------------
 * 三家各自独立：`google` / `umami` / `clarity`，每家一个 `enable`，可以并存
 * （Clarity 是热图与会话回放，和另外两家不是同一类东西）。总开关关掉就一行都不出。
 *
 * 只在**生产构建**里输出：`astro dev` 打开页面时不该往真实报表里灌 localhost 的
 * 访问。Astro 的 build 与 dev 是两条路，`import.meta.env.PROD` 正好分得开，
 * 所以开发时连脚本都不会下载 —— 比在报表后台配「排除 localhost」省事得多。
 *
 * 三家的共同点是「id 填了才算配好」：`enable` 开着但 id 空着，这里什么也不输出，
 * config/index.ts 会在构建期提醒补上。
 */
const ANALYTICS_ON = SITE.analytics.enable && import.meta.env.PROD;

const gaId = ANALYTICS_ON && SITE.analytics.google.enable
  ? SITE.analytics.google.measurementId.trim()
  : '';

const umami = ANALYTICS_ON && SITE.analytics.umami.enable ? SITE.analytics.umami : null;
const umamiSrc = umami?.src.trim() ?? '';
const umamiId = umami?.websiteId.trim() ?? '';
const umamiOn = Boolean(umamiSrc && umamiId);

const clarityId = ANALYTICS_ON && SITE.analytics.clarity.enable
  ? SITE.analytics.clarity.projectId.trim()
  : '';

/**
 * gtag 的初始化那三行、以及 Clarity 的自注入加载器，都写成字符串。
 *
 * 原因：`is:inline` 脚本的内容会被**原样**输出，不认 `{}` 插值；虽然可以用
 * `define:vars`，但那个依赖 Astro 把变量声明前置在当前作用域里 —— 一旦哪天
 * 它改成包一层 IIFE，`function gtag()` 就不再是全局的，统计会静默失效。
 * 走 `set:html` 拼字符串没有这个隐患。
 *
 * id 一律用 `JSON.stringify` 包一层：有人往配置里塞个引号也不会把脚本打断。
 */
const gaSnippet = gaId
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}` +
    `gtag('js',new Date());gtag('config',${JSON.stringify(gaId)});`
  : '';

/* Clarity 官方的安装代码原样照抄，只把项目 ID 换成配置里的值。
   它是「自注入」的：自己 createElement('script') 并设 async —— 所以没有外链
   script 标签，也没法用 dns-prefetch 之外的方式优化，这是它自己的设计。 */
const claritySnippet = clarityId
  ? `(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};` +
    `t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;` +
    `y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})` +
    `(window,document,"clarity","script",${JSON.stringify(clarityId)});`
  : '';

/**
 * 统计脚本的域名预解析。
 *
 * 只给 `dns-prefetch`、不给 `preconnect`：后者要立刻做一次完整握手（TCP + TLS），
 * 会占掉一条连接，而统计脚本是 async 的非关键资源 —— 首屏那几个请求更应该拿走
 * 这几毫秒。反过来 `dns-prefetch` 只花一次 DNS 查询，代价几乎为零。
 *
 * 同源的不必预解析（反代到 `/stats/script.js` 的情况），浏览器本来就有连接。
 */
const analyticsOrigins: string[] = [];
for (const url of [
  gaId ? 'https://www.googletagmanager.com' : '',
  umamiOn ? umamiSrc : '',
  clarityId ? 'https://www.clarity.ms' : '',
]) {
  if (!url) continue;
  try {
    const { origin: host } = new URL(url, origin);
    if (host !== origin.origin && !analyticsOrigins.includes(host)) analyticsOrigins.push(host);
  } catch {
    /* src 不是合法地址：留空即可，config 的构建期体检已经会说 */
  }
}

/* 站长验证：只填了才输出，`other` 里 name / content 缺一个就整条跳过 */
const verifyOther = SITE.verification.other.filter(
  (item) => item.name?.trim() && item.content?.trim(),
);
---

<!doctype html>
<html
  lang={SITE.lang}
  data-hue={hue !== null ? '' : undefined}
  style={hue !== null ? `--hue:${hue}` : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {/* 索引与摘要策略（列表页 noindex / 其余要大图预览），见 frontmatter 里 robotsContent 的说明 */}
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    {/* 站长认领：只出一行 meta，不放脚本、不发请求。填了才出现，见 config/user/analytics.ts */}
    {SITE.verification.google.trim() && (
      <meta name="google-site-verification" content={SITE.verification.google.trim()} />
    )}
    {SITE.verification.bing.trim() && (
      <meta name="msvalidate.01" content={SITE.verification.bing.trim()} />
    )}
    {verifyOther.map((item) => (
      <meta name={item.name.trim()} content={item.content.trim()} />
    ))}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title={SITE.title} href="/atom.xml" />
    {/* 首屏大图的 preload，见 frontmatter 里 bannerPreload 的说明 */}
    {
      bannerPreload && (
        <link rel="preload" as="image" href={bannerPreload} fetchpriority="high" />
      )
    }
    {/* 放在 </head> 最前面几条里：握手要趁早，评论脚本是懒加载的，
        等它开始下载再握手就白等一个 RTT 了 */}
    {
      preconnectList.map((item) => (
        <>
          <link rel="preconnect" href={item} />
          {/* 老浏览器没有 preconnect 时退化成 DNS 预解析，聊胜于无 */}
          <link rel="dns-prefetch" href={item} />
        </>
      ))
    }
    <meta name="theme-color" content={SITE.color.navbar} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={DARK_CHROME} media="(prefers-color-scheme: dark)" />

    {/* 统计脚本的域名预解析（只 DNS，不握手，理由见 frontmatter） */}
    {analyticsOrigins.map((host) => (
      <link rel="dns-prefetch" href={host} />
    ))}

    <!-- 配色来自 src/config 的 color 段，只覆盖亮色（见 frontmatter 里的说明） -->
    <style is:inline set:html={colorVars} />

    <!--
      Open Graph / Twitter。两家的字段大部分重叠，但都不接受相对路径：
      地址与封面在 frontmatter 里已经绝对化（见 utils/seo.ts）。

      og:image:type 从扩展名推，永远能推对。og:image:width/height **只在页面明确
      告诉我们尺寸时才写**（文章页自己裁的 1200×630）：尺寸不确定时标错比不标更糟，
      平台会照着错的宽高去排版。
    -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={ogLocale()} />
    <meta property="og:image" content={shareImg} />
    {shareMime && <meta property="og:image:type" content={shareMime} />}
    {
      imageSize && (
        <>
          <meta property="og:image:width" content={String(imageSize.width)} />
          <meta property="og:image:height" content={String(imageSize.height)} />
        </>
      )
    }
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {twitter && <meta name="twitter:site" content={`@${twitter}`} />}
    {twitter && <meta name="twitter:creator" content={`@${twitter}`} />}
    <meta name="twitter:image" content={shareImg} />
    <meta name="twitter:image:alt" content={shareAlt} />

    {
      ogType === 'article' && article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && (
            <meta property="article:modified_time" content={article.modified.toISOString()} />
          )}
          <meta property="article:author" content={SITE.author} />
          {article.section && <meta property="article:section" content={article.section} />}
          {(article.tags ?? []).map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <!-- 结构化数据：由页面用 utils/seo 生成，这里只负责输出 -->
    {jsonLd && <script type="application/ld+json" set:html={safeJson(jsonLd)} />}

    <!--
      深色模式：首帧就把 data-user-color-scheme 写到 html 上，避免闪白。
      优先级：用户手动选择（localStorage）> 站点默认值 > 系统偏好。
      必须是内联脚本（外链脚本会晚一帧），代价只有几行。
    -->
    <script is:inline define:vars={{ darkDefault: SITE.darkMode.enable ? SITE.darkMode.default : 'light' }}>
      (function () {
        try {
          var saved = localStorage.getItem('flux-color-scheme');
          var mode = saved;
          if (!mode || mode === 'auto') {
            if (darkDefault === 'auto') {
              mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            } else {
              mode = darkDefault;
            }
          }
          document.documentElement.dataset.userColorScheme = mode;
        } catch (e) {
          document.documentElement.dataset.userColorScheme = 'light';
        }
      })();
    </script>

    <!--
      访客统计：GA4 / Umami / Clarity，三家各自独立、可并存，配了才输出
      （见 config/user/analytics.ts）。

      都是 async 外链 + 一小段内联初始化 —— async 保证不挡解析，
      内容再小也不该让读者等它。刻意摆在 head 的最末尾而不是最前面：它不参与首屏渲染，
      排在前面的每一条 meta 都更该先被解析到。
    -->
    {gaId && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`}
        />
        <script is:inline set:html={gaSnippet} />
      </>
    )}
    {umamiOn && (
      <script
        is:inline
        async
        src={umamiSrc}
        data-website-id={umamiId}
        data-host-url={umami?.hostUrl?.trim() || undefined}
        data-domains={umami?.domains?.trim() || undefined}
        data-auto-track={umami?.autoTrack ? undefined : 'false'}
        data-exclude-search={umami?.excludeSearch ? 'true' : undefined}
        data-exclude-hash={umami?.excludeHash ? 'true' : undefined}
        data-performance={umami?.performance ? 'true' : undefined}
        data-errors={umami?.errors ? 'true' : undefined}
        data-release={umami?.errors ? umami?.errorRelease?.trim() || undefined : undefined}
      />
    )}
    {clarityId && <script is:inline set:html={claritySnippet} />}
  </head>

  <body class:list={[{ 'home-no-banner': isHome && !SITE.banner.enable }]}>
    <a class="skip-link" href="#main">{T.skipToContent}</a>

    <Navbar isHome={navbarTransparent} path={path} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {SITE.search && <SearchModal />}

    <button id="scroll-top" type="button" aria-label={T.backTop}>
      <Icon name="arrow-up" />
    </button>

    <script>
      import '../scripts/theme.js';
      import '../scripts/banner.js';
      /* 搜索只在站点开启时打包进页面（未开启时这段引用会被摇掉） */
      import '../scripts/search.js';
    </script>
  </body>
</html>

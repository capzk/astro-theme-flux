---
/**
 * Banner —— 全屏（或固定高度）头图 + 大标题 + 元信息
 *
 * 对应原版 `layout/_partials/header/banner.ejs`：蒙版之上是一个居中的
 * `.banner-text`，里面依次是标题、若干行 `.post-meta`。原版文章页的标题、
 * 日期、字数、阅读时长全部在这里显示，白色卡片里不再重复标题。
 *
 * 视差与打字机属于锦上添花且有额外 JS 依赖，暂不引入。
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { isAsset, type ImageSource } from '../utils/image';

/** banner 上的一条元信息（图标 + 文字） */
interface BannerMeta {
  icon: string;
  text: string;
}

interface Props {
  title: string;
  subtitle?: string;
  /**
   * 背景图。两种写法都认：
   * - 本地资源（`import` 进来的）→ `<Image>` 出多档宽度 + webp + srcset
   * - 字符串（public 路径 / 外链）→ CSS 背景图，原样输出、不优化
   * 留空则用顶栏色作纯色底。
   */
  img?: ImageSource;
  height?: string;
  maskAlpha?: number;
  /** 底部滚动提示箭头（通常只在首页） */
  scrollDown?: boolean;
  /**
   * 标题标签。首页用 h1；文章页用 div —— 页面里唯一的 h1 留给正文开头的
   * `<h1 id="seo-header">`（原版就是 div.h2 + 隐藏的 h1，保证只有一个 h1）。
   */
  headingTag?: 'h1' | 'div';
  /**
   * 标题下方的元信息，一维数组 = 一行。原版是「日期」一行、
   * 「字数 + 阅读时长」一行，两行之间间距更小。
   */
  metas?: BannerMeta[][];
}

const {
  title,
  subtitle,
  img,
  height = '60vh',
  maskAlpha = 0.3,
  scrollDown = false,
  headingTag = 'h1',
  metas = [],
} = Astro.props;

const Heading = headingTag;

/* 本地资源走 <Image>（下面单独渲染），字符串继续用 CSS 背景图 —— 
   后者不产生额外 DOM，也不会因为 <img> 的宽高比把 banner 撑变形。 */
const bgImage = img && !isAsset(img) ? img : '';

const style = [
  `height:${height}`,
  bgImage ? `background-image:url('${bgImage}')` : '',
].filter(Boolean).join(';');
---

<header class="banner" style={style}>
  {
    isAsset(img) && (
      <Image
        class="banner-img"
        src={img}
        alt=""
        widths={[720, 1080, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="banner-mask" style={`opacity:${maskAlpha}`}></div>
  <div class="banner-text">
    <Heading class="banner-title">{title}</Heading>
    {subtitle && <p class="banner-subtitle">{subtitle}</p>}
    {
      metas.filter((row) => row.length > 0).map((row) => (
        <div class="banner-metas">
          {row.map((m) => (
            <span class="banner-meta">
              <Icon name={m.icon} />
              {m.text}
            </span>
          ))}
        </div>
      ))
    }
  </div>
  {
    scrollDown && (
      <a class="scroll-down-bar" href="#board" aria-label="向下滚动">
        <Icon name="chevron-down" />
      </a>
    )
  }
</header>

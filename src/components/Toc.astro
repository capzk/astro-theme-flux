---
/**
 * Toc —— 文章右侧目录
 *
 * 对应原版 `layout/_partials/post/toc.ejs` + `source/css/_pages/_base/_widget/toc.styl`。
 *
 * 原版用 tocbot 在浏览器里扫描 `.markdown-body` 的 h2~h6 现场生成目录；这里是
 * 构建期就把 Astro 的 `headings` 渲染成静态列表 —— 无运行时依赖、无闪白，
 * 首屏就有目录，剩下的滚动高亮交给 theme.js。
 *
 * 层级不用嵌套 <ol>，而是给每项打 `data-depth`，靠 CSS 缩进：
 * 视觉与原版的逐级 padding 一致，但滚动高亮时是一个扁平数组，遍历更快。
 */
import Icon from './Icon.astro';
import { T } from '../i18n';

interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<aside class="sidebar">
  <div id="toc">
    <p class="toc-header">
      <Icon name="list" />
      <span>{T.toc}</span>
    </p>
    <div class="toc-body" id="toc-body">
      <ol class="toc-list">
        {
          items.map((item) => (
            <li class="toc-item" data-depth={item.depth}>
              <a class="toc-link" href={`#${item.slug}`}>
                {item.text}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</aside>

---
/**
 * Toc —— 文章右侧目录（递归）
 *
 * 结构在构建期生成，滚动高亮由 src/scripts/theme.js 里的 IntersectionObserver 负责。
 * 原版用 tocbot（+ jQuery），这里零依赖。
 */
import type { TocNode } from '../utils/toc';

interface Props {
  items: TocNode[];
  /** 当前嵌套深度，用于缩进 */
  depth?: number;
}

const { items, depth = 0 } = Astro.props;
---

<ul class="toc-list" data-depth={depth}>
  {
    items.map((node) => (
      <li>
        <a class="toc-link" href={`#${node.slug}`} data-toc-depth={node.depth}>
          {node.text}
        </a>
        {node.children.length > 0 && <Astro.self items={node.children} depth={depth + 1} />}
      </li>
    ))
  }
</ul>

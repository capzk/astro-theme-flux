---
/**
 * Comments —— 评论区
 * ---------------------------------------------------------------------------
 * 评论是本站唯一的运行时外部依赖，所以这里刻意做窄：
 *
 *   · 没配置好就整块不渲染（不留空壳、不发一个注定失败的请求）；
 *   · 具体是哪一家由 SITE.comment.type 决定，组件只知道「有一个 payload」；
 *   · 加载中给骨架屏、失败给可重试的提示，评论挂了不影响正文。
 *
 * 组件只负责「长什么样」和「配置怎么传到浏览器」；加载与挂载在
 * src/scripts/comments.js，各家评论系统自己的挂载逻辑在 src/comments/client/。
 *
 * 想放到关于页 / 留言板，直接 `<Comments />` 即可：路径默认取当前页。
 */
import { SITE } from '../config';
import { commentContext, hasCommentForm, resolveComments } from '../comments';
import { T } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  /** 评论归属路径。默认当前页 pathname，一般不用传 */
  path?: string;
}

const { path: pathOverride } = Astro.props;

/* 页面那边一般已经判过一次；这里再判一次是为了「随便丢到哪个页面都能用」 */
if (!hasCommentForm(SITE.comment)) return;

const ctx = commentContext(Astro.url, {
  site: Astro.site,
  lang: SITE.lang,
  path: pathOverride,
});
const { section } = resolveComments(SITE.comment, ctx);
if (!section) return;

/* 只把有值的键发给浏览器：undefined 序列化不掉，脚本里还得再过滤一遍 */
const payload = JSON.stringify(section)
  /* JSON 里出现 `</script>` 会提前闭合标签，把 `<` 转义掉最省心 */
  .replace(/</g, '\\u003c');
---

<section
  class="comment-section"
  aria-labelledby="comment-title"
  data-state="loading"
  data-error={T.commentLoadFailed}
>
  <h2 class="comment-title" id="comment-title">
    <Icon name="comment" />
    <span>{T.comments}</span>
    {/* 徽标里的数字由评论系统自己回填；不回填（这家没有计数接口）就整枚不渲染。
        所以这里不放 hidden —— 那是静态的，回填了也不会显示出来 */}
    {
      section.countClass && (
        <span class="comment-count">
          <span class={section.countClass}></span>
          {T.commentCountUnit}
        </span>
      )
    }
  </h2>

  {/* 评论系统挂载到这里。Waline 挂载时会清空子节点，骨架屏因此自动消失，
      不用我们在脚本里手动移除 */}
  <div class="comment-body" aria-busy="true">
    <div class="comment-skeleton" aria-hidden="true">
      <span class="comment-skeleton-panel"></span>
      <span class="comment-skeleton-line"></span>
      <span class="comment-skeleton-line"></span>
      <span class="comment-skeleton-line is-short"></span>
    </div>
  </div>

  <div class="comment-status" role="status" hidden>
    <p class="comment-status-text" />
    <button type="button" class="comment-retry">{T.commentRetry}</button>
  </div>

  <noscript>
    <p class="comment-status-text">{T.commentNoScript}</p>
  </noscript>

  <script type="application/json" class="comment-config" is:inline set:html={payload} />
</section>

<script>
  import '../scripts/comments.js';
</script>

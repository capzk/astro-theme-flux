---
/**
 * Pagination —— 页码条
 *
 * 原版由 Hexo 的 paginator 生成，样式是「数字按钮 + 当前页高亮」。
 * 路径约定与 Hexo 一致：第 1 页是 `<base>/`，第 N 页是 `<base>/page/N/`。
 * 首页、归档、分类、标签都走同一份 —— 差别只在传进来的 base。
 */
import { T } from '../i18n';
import { pageUrlOf } from '../utils/posts';
import Icon from './Icon.astro';

interface Props {
  currentPage: number;
  lastPage: number;
  /** 列表首页地址，必须以 `/` 结尾：`/`、`/archives/`、`/categories/前端/` */
  base?: string;
}

const { currentPage, lastPage, base = '/' } = Astro.props;

const pageUrl = (n: number) => pageUrlOf(base, n);

/** 页码窗口：首页、末页、当前页前后各 1 页，其余用省略号 */
function windowPages(current: number, last: number): (number | '…')[] {
  const out: (number | '…')[] = [];
  for (let i = 1; i <= last; i += 1) {
    if (i === 1 || i === last || Math.abs(i - current) <= 1) out.push(i);
    else if (out[out.length - 1] !== '…') out.push('…');
  }
  return out;
}

const pages = windowPages(currentPage, lastPage);
---

{
  lastPage > 1 && (
    <nav class="pagination" aria-label="分页导航">
      {currentPage > 1 ? (
        <a class="page-link" href={pageUrl(currentPage - 1)} rel="prev" aria-label={T.prevPage}>
          <Icon name="arrow-left" />
        </a>
      ) : (
        <span class="page-link is-disabled" aria-hidden="true">
          <Icon name="arrow-left" />
        </span>
      )}

      {pages.map((p) =>
        p === '…' ? (
          <span class="page-ellipsis">…</span>
        ) : (
          <a
            class:list={['page-link', { 'is-current': p === currentPage }]}
            href={pageUrl(p)}
            aria-current={p === currentPage ? 'page' : undefined}
          >
            {p}
          </a>
        ),
      )}

      {currentPage < lastPage ? (
        <a class="page-link" href={pageUrl(currentPage + 1)} rel="next" aria-label={T.nextPage}>
          <Icon name="arrow-right" />
        </a>
      ) : (
        <span class="page-link is-disabled" aria-hidden="true">
          <Icon name="arrow-right" />
        </span>
      )}
    </nav>
  )
}

---
/**
 * PostCard —— 首页 / 列表页的一张卡片
 *
 * 原版结构：左侧封面缩略图（md 以上 1/3 宽），右侧标题 + 摘要 + 底部 meta。
 * 截图里的观感主要来自三件事，这里都保住了：封面有投影、摘要固定三行、
 * meta 用小号灰字排成一行。
 */
import { SITE } from '../config';
import { T } from '../i18n';
import type { Post } from '../utils/posts';
import { postUrl, termUrl } from '../utils/posts';
import Icon from './Icon.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, categories, tags, sticky, indexImg } = post.data;
const url = postUrl(post);
const summary = SITE.index.excerptLength;

/* 摘要：description 优先，否则取正文纯文本（构建期算好，无运行时开销） */
const { plainText } = await import('../utils/posts');
const desc = post.data.description?.trim() || plainText(post.body ?? '');
const excerpt = desc.length > summary ? `${desc.slice(0, summary).trim()}…` : desc;

const dateText = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article class="index-card">
  {
    (indexImg || SITE.index.defaultImg) && (
      <div class="index-img">
        <a href={url} aria-hidden="true" tabindex="-1">
          <img src={indexImg || SITE.index.defaultImg} alt={title} loading="lazy" width="480" height="320" />
        </a>
      </div>
    )
  }

  <div class="index-info">
    <h2 class="index-header">
      {sticky && <span class="index-pin">{T.pin}</span>}
      <a href={url}>{title}</a>
    </h2>

    <a class="index-excerpt" href={url}>{excerpt}</a>

    <div class="index-btm">
      {
        SITE.index.showDate && (
          <span class="post-meta">
            <Icon name="date" />
            <time datetime={date.toISOString()}>{dateText}</time>
          </span>
        )
      }
      {
        SITE.index.showCategory &&
          categories.length > 0 && (
            <span class="post-meta">
              <Icon name="folder" />
              {categories.map((c, i) => (
                <>
                  {i > 0 && ' / '}
                  <a href={termUrl('categories', c)}>{c}</a>
                </>
              ))}
            </span>
          )
      }
      {
        SITE.index.showTags && tags.length > 0 && (
          <span class="post-meta">
            <Icon name="tag" />
            {tags.map((tag) => (
              <a href={termUrl('tags', tag)}>#{tag}</a>
            ))}
          </span>
        )
      }
    </div>
  </div>
</article>

---
/**
 * Footer —— 页脚
 *
 * 四行，从上到下：版权 + 站龄 / 订阅入口 / 主题信息 / 备案（可选）。
 * 前半部分是构建期算好的；只有站龄需要浏览器参与 —— 静态站可能一年不重新构建，
 * 构建期定死的天数会停在构建那天。
 *
 * 原版那行「N 篇文章 · N 个标签」去掉了：读者不关心，站主也不需要靠页脚
 * 判断站点规模 —— 归档页本来就是干这个的，而且那行数字每加一篇文章都会变。
 *
 * 现在这里的数字是**累计浏览量与访客数**（来自 Umami 回读，构建期取）。
 * 和「N 篇文章」的区别在于它是向上长的、读者看得懂的量。取不到就整段不渲染。
 */
import { SITE } from '../config';
import { T } from '../i18n';
import { formatCount, getUmamiStats } from '../utils/umami';

const year = new Date().getFullYear();
const since = SITE.since && SITE.since !== year ? `${SITE.since}–${year}` : String(year);

/* 站龄起点：优先 footer.runtime.since，没写就退到 `since` 那一年的 1 月 1 日 */
const runtimeSince = (SITE.footer.runtime.since || `${SITE.since ?? year}-01-01`).trim();

/* 构建当天的天数 —— 无脚本时的兜底，脚本会按访问当天重算。日期写坏了就是 NaN */
const runtimeDays = Math.floor(
  (Date.now() - new Date(runtimeSince).getTime()) / 86_400_000,
);
const runtime = SITE.footer.runtime.enable && Number.isFinite(runtimeDays);

/* 开着但没填备案号，等于摆一行空的链接 —— 当成没开 */
const beian = SITE.footer.beian;
const showBeian = beian.enable && beian.text.trim() !== '';

/* 全站累计。构建期取，所以是构建那一刻的数字；取不到（没配密钥 / 接口挂了）
   就是 null，整段不渲染 —— 页脚不该出现「0 次浏览」这种更难看的东西 */
const siteTotal = SITE.analytics.umami.stats.siteTotal ? (await getUmamiStats()).site : null;
const pageviewsText = siteTotal && siteTotal.pageviews > 0 ? T.sitePageviews(formatCount(siteTotal.pageviews)) : '';
const visitorsText = siteTotal && siteTotal.visitors > 0 ? T.siteVisitors(formatCount(siteTotal.visitors)) : '';
---

<footer>
  <div class="container">
    <div class="footer-inner">
      <div class="footer-meta">
        <span>© {since} <a href="/">{SITE.title}</a></span>
        {
          runtime && (
            <span class="footer-runtime" data-since={runtimeSince} data-text={T.runtimeDays}>
              {T.runtimeDays.replace('{n}', String(Math.max(0, runtimeDays)))}
            </span>
          )
        }
        {/* 两个 span 而不是一个：中间那个「·」由 .footer-meta > * + *::before 出，
            读屏不会把它念出来 */}
        {pageviewsText && <span class="footer-stats">{pageviewsText}</span>}
        {visitorsText && <span class="footer-stats">{visitorsText}</span>}
      </div>

      {
        SITE.footer.links && (
          <nav class="footer-links" aria-label={T.footerLinks}>
            <a href="/rss.xml">RSS</a>
            <a href="/atom.xml">Atom</a>
            <a href="/sitemap-index.xml">Sitemap</a>
          </nav>
        )
      }

      <div class="footer-powered">
        {T.footerPowered}{' '}
        <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
        {' · '}
        {T.footerTheme}{' '}
        <a href="https://github.com/capzk/astro-theme-flux" target="_blank" rel="noopener noreferrer">
          Flux
        </a>
      </div>

      {
        showBeian && (
          <div class="footer-beian">
            <a href={beian.link} target="_blank" rel="noopener noreferrer">
              {beian.text}
            </a>
          </div>
        )
      }
    </div>
  </div>
</footer>

---
/**
 * Footer —— 页脚
 * ---------------------------------------------------------------------------
 * 三行居中：订阅入口 / 技术栈胶囊 / 版权与备案。可展示的文字全部走
 * `user/footer.ts`，组件本身不写死任何正文（除订阅的 RSS / Atom / Sitemap 三个专有名词）。
 *
 * 站龄天数由浏览器校正（见 theme.js 第 9 节）：静态站可能很久不重建，
 * 构建期定死的数字会停在旧值上，所以这里先给构建当天的结果做无脚本兜底。
 */
import { SITE } from '../config';
import { T } from '../i18n';

const f = SITE.footer;
const year = new Date().getFullYear();

/* 版权：配置优先，支持 {since} {year} {title}；留空自动「© 起始年–今年 标题」 */
const sinceSpan = SITE.since && SITE.since !== year ? `${SITE.since}–${year}` : String(year);
const copyright = (f.copyright || `© ${sinceSpan} ${SITE.title} · 保留所有权利`)
  .replace(/\{since\}/g, String(SITE.since ?? year))
  .replace(/\{year\}/g, String(year))
  .replace(/\{title\}/g, SITE.title);

/* 站龄起点：优先 footer.runtime.since，没写就退到 site.since 那一年的 1 月 1 日 */
const runtimeSince = (f.runtime.since || `${SITE.since ?? year}-01-01`).trim();
const runtimeDays = Math.floor((Date.now() - new Date(runtimeSince).getTime()) / 86_400_000);
const showRuntime = f.runtime.enable && Number.isFinite(runtimeDays);

/* 备案：开着却没填号，等于摆一行空链接 —— 当成没开 */
const beian = f.beian;
const showBeian = beian.enable && beian.text.trim() !== '';

/* 技术栈胶囊：过滤掉没填 label / href 的空项 */
const pills = f.poweredBy.filter((p) => p.label && p.href);
const showStack = pills.length > 0 || showRuntime;

/**
 * 内置图标：内联 SVG 的 body 字符串（路径自带 fill / stroke）。
 * 不认识的 icon 一律回落到通用链接图标 —— 配置写错也不会在页脚留个空洞。
 */
const ICONS: Record<string, { viewBox: string; body: string }> = {
  astro: {
    viewBox: '0 0 24 24',
    body: '<path fill="currentColor" d="M12 2.2c.3 0 .6.2.7.5l3.7 11.3-1.7-1L12 19l-2.7-6-1.7 1L11.3 2.7c.1-.3.4-.5.7-.5z"/><path d="M6 18.5c1.3-.6 3.5-1 6-1s4.7.4 6 1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  },
  vercel: {
    viewBox: '0 0 24 24',
    body: '<path fill="currentColor" d="M12 4l9 16H3L12 4z"/>',
  },
  cloudflare: {
    viewBox: '0 0 24 24',
    body: '<path fill="currentColor" d="M17.5 18H7a4 4 0 0 1-.4-8 5.5 5.5 0 0 1 10.6 1.4A3.5 3.5 0 0 1 17.5 18z"/>',
  },
  flux: {
    viewBox: '0 0 24 24',
    body: '<g fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M3 12c2-3.6 4-3.6 6 0s4 3.6 6 0 4-3.6 6 0"/><path d="M3 17c2-2.4 4-2.4 6 0s4 2.4 6 0 4-2.4 6 0" opacity=".5"/></g>',
  },
  github: {
    viewBox: '0 0 24 24',
    body: '<path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/>',
  },
  link: {
    viewBox: '0 0 24 24',
    body: '<g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></g>',
  },
};

const iconOf = (name?: string) => ICONS[name ?? 'link'] ?? ICONS.link;
---

<footer>
  <div class="container">
    <div class="footer-inner">
      {
        f.links && (
          <nav class="footer-row footer-subscribe" aria-label={T.footerLinks}>
            <a href="/rss.xml">
              <svg class="footer-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
              </svg>
              RSS
            </a>
            <span class="footer-sep" aria-hidden="true">
              ·
            </span>
            <a href="/atom.xml">
              <svg class="footer-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" />
                <ellipse cx="12" cy="12" rx="10" ry="4.6" />
                <ellipse cx="12" cy="12" rx="10" ry="4.6" transform="rotate(60 12 12)" />
                <ellipse cx="12" cy="12" rx="10" ry="4.6" transform="rotate(120 12 12)" />
              </svg>
              Atom
            </a>
            <span class="footer-sep" aria-hidden="true">
              ·
            </span>
            <a href="/sitemap-index.xml">
              <svg class="footer-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="3" width="6" height="5" rx="1.2" />
                <rect x="3" y="16" width="6" height="5" rx="1.2" />
                <rect x="15" y="16" width="6" height="5" rx="1.2" />
                <path d="M12 8v5M6 16v-3h12v3" />
              </svg>
              Sitemap
            </a>
          </nav>
        )
      }

      {
        showStack && (
          <div class="footer-row footer-stack">
            {pills.map((p) => {
              const icon = iconOf(p.icon);
              const external = p.external !== false;
              return (
                <a
                  class:list={['pill', `is-${p.icon ?? 'link'}`]}
                  href={p.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <svg class="footer-svg" viewBox={icon.viewBox} aria-hidden="true">
                    <Fragment set:html={icon.body} />
                  </svg>
                  <span>{p.label}</span>
                </a>
              );
            })}
            {showRuntime && (
              <span class="pill uptime">
                <span class="pulse" aria-hidden="true" />
                <span class="footer-runtime" data-since={runtimeSince} data-text={T.runtimeDays}>
                  {T.runtimeDays.replace('{n}', String(Math.max(0, runtimeDays)))}
                </span>
              </span>
            )}
          </div>
        )
      }

      <div class="footer-row footer-meta">
        <span>{copyright}</span>
        {
          showBeian && (
            <>
              <span class="footer-sep" aria-hidden="true">
                ·
              </span>
              <a class="beian" href={beian.link} target="_blank" rel="noopener noreferrer">
                <svg class="footer-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3l7 2.8v5.2c0 4.5-3 7.9-7 10-4-2.1-7-5.5-7-10V5.8L12 3z" />
                  <path d="M9 12l2 2 4-4" />
                </svg>
                {beian.text}
              </a>
            </>
          )
        }
      </div>
    </div>
  </div>
</footer>

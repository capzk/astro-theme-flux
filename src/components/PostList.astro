---
/**
 * PostList —— 卡片流 + 分页
 *
 * 首页与 `/page/N/` 共用这一份（差异只在页码）。
 */
import Pagination from './Pagination.astro';
import PostCard from './PostCard.astro';
import type { Post } from '../utils/posts';

interface Props {
  posts: Post[];
  currentPage: number;
  lastPage: number;
  /** 列表首页地址（以 `/` 结尾）：首页 `/`、归档 `/archives/`、分类 `/categories/前端/` */
  base?: string;
}

const { posts, currentPage, lastPage, base = '/' } = Astro.props;
---

<div class="index-list">
  {posts.map((post) => <PostCard post={post} />)}
</div>

{posts.length === 0 && <p class="search-empty">还没有文章。在 src/content/posts/ 里放一篇 Markdown 就会出现。</p>}

<Pagination currentPage={currentPage} lastPage={lastPage} base={base} />
